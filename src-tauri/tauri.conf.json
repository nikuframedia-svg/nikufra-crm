{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Nikufra CRM",
  "version": "0.1.1",
  "identifier": "ai.nikufra.crm",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Nikufra CRM",
        "width": 1440,
        "height": 920,
        "minWidth": 1180,
        "minHeight": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' http://127.0.0.1:8000 http://localhost:8000 ws://127.0.0.1:8000 ws://localhost:8000 https://crm.nikufra.ai wss://crm.nikufra.ai; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": [
          "nikufra-crm"
        ]
      }
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDM4RkM4NTY2MDNCRDQwRgpSV1FQMUR0Z1ZzaVBBeEkzMUFDY2VUYzVBa0M2WTZOcUJqQ01zVXFxTzZWT2JzRHlONzA1d0VPeQo=",
      "endpoints": [
        "https://crm.nikufra.ai/updates/latest.json"
      ]
    }
  }
}
