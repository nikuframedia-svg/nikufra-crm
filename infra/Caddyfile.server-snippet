crm.nikufra.ai {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "no-referrer"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	@update_metadata path /updates/latest.json /updates/downloads.json
	handle @update_metadata {
		root * /srv/ocr-portal/crm-updates
		uri strip_prefix /updates
		header Cache-Control "no-store"
		file_server
	}

	handle_path /updates/assets/* {
		root * /srv/ocr-portal/crm-updates/assets
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	redir /download /download/ 308

	handle_path /download/* {
		root * /srv/ocr-portal/crm-download
		try_files {path} /index.html
		header Cache-Control "no-store"
		file_server
	}

	reverse_proxy 127.0.0.1:8800
}
