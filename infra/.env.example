# Nunca colocar valores reais neste ficheiro versionado.
CRM_DOMAIN=crm.nikufra.ai
CRM_PUBLIC_IP=188.40.230.28
CRM_API_PORT=8800
TLS_EMAIL=infra@nikufra.ai

POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRY=3600
ANON_KEY=
SERVICE_ROLE_KEY=
SECRET_KEY_BASE=
REALTIME_DB_ENC_KEY=
PG_META_CRYPTO_KEY=
TOKEN_ENCRYPTION_KEY=

# Outreach arranca sempre sem outbound. A promoção para canary/live exige
# também o estado equivalente na base de dados e aprovação administrativa.
OUTREACH_API_PORT=8787
OUTREACH_DATABASE_PASSWORD=
OUTREACH_ENCRYPTION_CURRENT_VERSION=1
OUTREACH_ENCRYPTION_KEY_V1=
OUTREACH_ENCRYPTION_KEYS=
OUTREACH_STATE_HMAC_SECRET=
OUTREACH_WEBHOOK_SECRET=
OUTREACH_UNSUBSCRIBE_SECRET=
OUTREACH_SEND_ENABLED=false
OUTREACH_SHADOW_MODE=true
OUTREACH_ADMIN_ONLY=true
OUTREACH_CANARY_ALLOWLIST=joao@nikufra.ai,joaomilhazes71@gmail.com
OUTREACH_GOOGLE_CLIENT_ID=
OUTREACH_GOOGLE_CLIENT_SECRET=
OUTREACH_GOOGLE_PUBSUB_VERIFICATION_TOKEN=
OUTREACH_SCHEDULER_INTERVAL_SECONDS=15
OUTREACH_INBOUND_SYNC_INTERVAL_SECONDS=60

DASHBOARD_USERNAME=nikufra-admin
DASHBOARD_PASSWORD=

SMTP_ADMIN_EMAIL=hello@nikufra.ai
SMTP_HOST=smtp-relay.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Em produção, o hook assinado envia convites e magic links pelo Gmail API.
# Mantê-lo desligado até https://CRM_DOMAIN estar acessível e com TLS válido.
AUTH_EMAIL_HOOK_ENABLED=false
AUTH_EMAIL_HOOK_SECRET=
AUTH_EMAIL_HOOK_URI=http://host.docker.internal:9000/send-auth-email

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

RCLONE_REMOTE=remote:crm-backups
BACKUP_FAILURE_EMAIL=infra@nikufra.ai
BACKUP_ENCRYPTION_KEY_FILE=/home/luis/.config/nikufra-crm/backup.key
BACKUP_CONTAINER_UID=1000
BACKUP_CONTAINER_GID=1000
WAL_ARCHIVE_PASSWORD=
# Hard ceiling for WAL retained by the permanent offsite replication slot.
# Size this below the free capacity of the PostgreSQL data volume.
POSTGRES_MAX_SLOT_WAL_KEEP_SIZE=4096MB
# Readiness fails before the slot reaches its ceiling, leaving room to react.
WAL_SLOT_MIN_SAFE_BYTES=536870912
