{
  "name": "nikufra-crm",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:e2e:auth": "./infra/test-local-auth-flow.sh",
    "test:e2e:outreach": "playwright test tests/e2e/outreach.spec.ts",
    "test:database": "./infra/test-database.sh --bootstrap",
    "release:verify": "pnpm security:audit && pnpm test:all && pnpm build:all && pnpm test:e2e:outreach",
    "security:audit": "pnpm audit",
    "local:configure": "./infra/configure-local.sh",
    "local:up": "./infra/local-up.sh",
    "local:down": "./infra/local-down.sh",
    "outreach:test": "pnpm --dir services/outreach test",
    "outreach:typecheck": "pnpm --dir services/outreach typecheck",
    "outreach:build": "pnpm --dir services/outreach build",
    "test:all": "pnpm test && pnpm outreach:test",
    "build:all": "pnpm build && pnpm outreach:build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
    "@dnd-kit/sortable": "^8.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/supabase-js": "^2.117.2",
    "@tanstack/react-query": "^5.104.0",
    "@tanstack/react-router": "^1.170.40",
    "@tanstack/react-table": "^8.20.5",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.441.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.12.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "autoprefixer": "^10.6.1",
    "jsdom": "^25.0.0",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.11",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11"
  }
}
