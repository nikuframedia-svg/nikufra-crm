{
  "name": "@nikufra/outreach-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "dev:api": "tsx watch src/api.ts",
    "dev:worker": "tsx watch src/worker.ts",
    "start:api": "node dist/api.js",
    "start:worker": "node dist/worker.js",
    "migrate:legacy": "node dist/migrate.js",
    "rotate:keys": "node dist/rotate-keys.js"
  },
  "dependencies": {
    "imapflow": "2.2.1",
    "mailparser": "3.9.33",
    "nodemailer": "10.0.13",
    "pg": "8.23.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/mailparser": "3.9.0",
    "@types/node": "22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  },
  "pnpm": {
    "overrides": {
      "linkify-it": "5.0.2",
      "nodemailer": "10.0.13"
    }
  }
}
